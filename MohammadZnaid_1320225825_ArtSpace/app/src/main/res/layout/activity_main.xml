<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F0"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/artworkCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1 / 6"
        android:textSize="24sp"
        android:textColor="#211A16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />

    <ImageView
        android:id="@+id/artworkImage"
        android:layout_width="330dp"
        android:layout_height="340dp"
        android:layout_marginTop="18dp"
        android:contentDescription="Artwork image"
        android:scaleType="fitCenter"
        android:src="@drawable/art1"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:elevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/artworkCounter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/artworkInfoCard"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#F2D8C8"
        app:layout_constraintTop_toBottomOf="@id/artworkImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/artworkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camel of Hardship"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#33251E" />

        <TextView
            android:id="@+id/artworkArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sliman Mansour (1973)"
            android:textSize="16sp"
            android:textColor="#66554A" />

    </LinearLayout>

    <Button
        android:id="@+id/previousButton"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Previous"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:enabled="false"
        android:backgroundTint="#795548"
        app:layout_constraintTop_toBottomOf="@id/artworkInfoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/nextButton" />

    <Button
        android:id="@+id/nextButton"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="Next"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#795548"
        app:layout_constraintTop_toBottomOf="@id/artworkInfoCard"
        app:layout_constraintStart_toEndOf="@id/previousButton"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>